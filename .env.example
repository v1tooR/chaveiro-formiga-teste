# =====================================================================
# Chaveiro Formiga — variáveis de ambiente
#
# Valores com espaço PRECISAM de aspas. O docker compose aceita sem, mas
# os scripts em scripts/ usam `source .env`, e aí `NOME=Chaveiro Formiga`
# faz o shell tentar executar `Formiga`.
# ---------------------------------------------------------------------
# Copie para `.env` e preencha. O `.env` NÃO vai para o git (.gitignore).
# Confira com:  git check-ignore -v .env
#
# Gere os segredos com:
#   openssl rand -hex 32          # JWT_SECRET, senhas
#   openssl rand -hex 8           # REALTIME_ENC_KEY (16 caracteres!)
# =====================================================================


# ---------------------------------------------------------------------
# FRONTEND (Vite) — só variáveis VITE_* chegam ao navegador
# ---------------------------------------------------------------------
# ATENÇÃO: tudo com prefixo VITE_ é EMBUTIDO NO BUNDLE e fica público.
# Nunca coloque service_role key, senha ou token de API aqui.

VITE_SUPABASE_URL=http://localhost:8000
# Chave anônima (JWT com role=anon). Pública por design: a RLS é que protege.
VITE_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------
# POSTGRES
# ---------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=

# Conexão de leitura/consulta.
SUPABASE_DB_URL=postgresql://postgres:SENHA_AQUI@127.0.0.1:54322/postgres

# Conexão para MIGRATIONS, SEEDS e RESET.
#
# Precisa ser `supabase_admin`, não `postgres`: a extensão supautils
# reatribui a posse dos objetos criados por `postgres` para
# `supabase_admin`, e `postgres` não pode assumir esse papel. Sem isso, a
# segunda migration com CREATE OR REPLACE falha com "must be owner".
# Os scripts montam esta URL sozinhos a partir de POSTGRES_PASSWORD;
# preencha só se o banco estiver em outro host.
SUPABASE_DB_ADMIN_URL=


# ---------------------------------------------------------------------
# JWT / API KEYS
# ---------------------------------------------------------------------
# JWT_SECRET: mínimo 32 caracteres. Trocar invalida todas as sessões.
JWT_SECRET=
JWT_EXPIRY=3600

# ANON_KEY e SERVICE_ROLE_KEY são JWTs assinados com o JWT_SECRET acima.
# Gere em https://supabase.com/docs/guides/self-hosting#api-keys
# ou com o script: ./scripts/gen-keys.sh
ANON_KEY=
# SERVICE_ROLE_KEY IGNORA TODA A RLS. Nunca no frontend, nunca no git,
# nunca em log. Só em Edge Functions e scripts de servidor.
SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------
# KONG (API Gateway)
# ---------------------------------------------------------------------
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


# ---------------------------------------------------------------------
# AUTH (GoTrue)
# ---------------------------------------------------------------------
SITE_URL=http://localhost:5186
ADDITIONAL_REDIRECT_URLS=http://localhost:5186,http://localhost:4173
API_EXTERNAL_URL=http://localhost:8000

# Sem auto-cadastro: só o responsável cria usuários.
#
# ⚠️ DISABLE_SIGNUP e ENABLE_EMAIL_SIGNUP fazem coisas DIFERENTES:
#   DISABLE_SIGNUP=true       → bloqueia auto-cadastro (é o que queremos)
#   ENABLE_EMAIL_SIGNUP=false → desliga o PROVEDOR de e-mail INTEIRO,
#                               inclusive o login com senha. Com isso,
#                               NINGUÉM entra: o /token responde
#                               "email_provider_disabled".
# Portanto: DISABLE_SIGNUP=true e ENABLE_EMAIL_SIGNUP=true.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# SMTP — necessário para recuperação de senha em produção.
SMTP_ADMIN_EMAIL=admin@chaveiroformiga.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="Chaveiro Formiga"
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify


# ---------------------------------------------------------------------
# REALTIME  ⚠️  AS DUAS PEGADINHAS DO SELF-HOSTED
# ---------------------------------------------------------------------
# 1) REALTIME_ENC_KEY precisa ter EXATAMENTE 16 caracteres (AES-128).
#    Com 15 ou 17 o container SOBE, aceita conexão e simplesmente NÃO
#    entrega evento nenhum — sem erro no log. É o bug mais caro de
#    diagnosticar do stack.
#      openssl rand -hex 8    →  16 caracteres
REALTIME_ENC_KEY=

# 2) SECRET_KEY_BASE: mínimo 64 caracteres.
#      openssl rand -hex 32   →  64 caracteres
SECRET_KEY_BASE=

# 3) O container OBRIGATORIAMENTE se chama `realtime-dev.supabase-realtime`
#    e o Kong aponta para esse hostname. O Realtime resolve o tenant pelo
#    SUBDOMÍNIO do host, então `realtime` ou `supabase-realtime` puro
#    falha em silêncio. Isso está fixado no docker-compose.yml —
#    não renomeie o serviço.
REALTIME_TENANT=realtime-dev

# 4) O Postgres precisa de wal_level=logical, senão não há replicação
#    lógica e o Realtime não recebe nada. Já configurado no compose.


# ---------------------------------------------------------------------
# STORAGE
# ---------------------------------------------------------------------
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=10485760
STORAGE_FILE_STORAGE_BACKEND_PATH=/var/lib/storage
# Redimensionamento de imagem (opcional; desligado por padrão).
IMGPROXY_ENABLE_WEBP_DETECTION=true


# ---------------------------------------------------------------------
# STUDIO / META
# ---------------------------------------------------------------------
STUDIO_PORT=54323
STUDIO_DEFAULT_ORGANIZATION="Chaveiro Formiga"
STUDIO_DEFAULT_PROJECT=chaveiro-formiga
SUPABASE_PUBLIC_URL=http://localhost:8000
# Painel do Studio protegido por basic auth.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=


# ---------------------------------------------------------------------
# POOLER (Supavisor)
# ---------------------------------------------------------------------
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=chaveiro-formiga
POOLER_DB_POOL_SIZE=5


# ---------------------------------------------------------------------
# SEED — usuário administrador inicial
# ---------------------------------------------------------------------
# Consumido por scripts/reset-to-prod.sh e seeds/seed_prod.sql.
SEED_ADMIN_EMAIL=wallace@chaveiroformiga.com.br
SEED_ADMIN_PASSWORD=


# ---------------------------------------------------------------------
# SEGREDOS DAS INTEGRAÇÕES  (Edge Functions — NUNCA no banco)
# ---------------------------------------------------------------------
# A tabela `integrations` guarda apenas o NOME da variável em
# `secret_ref`. O valor vive aqui e é publicado com:
#   supabase secrets set WHATSAPP_API_TOKEN=...
#
# Preencha só quando a integração correspondente for habilitada na tela
# de Configurações → Integrações (última etapa da implementação).

# whatsapp_notify / whatsapp_receipt / whatsapp_order
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# order_pdf
PDF_SERVICE_TOKEN=

# data_export / report_share
EXPORT_SIGNING_SECRET=

# =====================================================================
# SUPABASE CLOUD
# ---------------------------------------------------------------------
# Preencha só se for publicar num projeto hospedado. Com estas variáveis:
#   npm run cloud:deploy    migrations + seed de produção + admin
# =====================================================================

# Ref do projeto (o subdomínio da URL).
SUPABASE_PROJECT_REF=

# URI completa em Settings → Database → Connection string → URI.
# Contém a senha: NUNCA committar. Prefira a do pooler (IPv4); a conexão
# direta é IPv6-only em projetos novos e falha em muita rede.
SUPABASE_DB_URL_CLOUD=

# sb_secret_… em Settings → API Keys. Usada só pela Admin API, no
# servidor, para criar o login do responsável. Ignora TODA a RLS —
# nunca no bundle, nunca em log.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------
# O front lê estas duas (Vite, não Next.js — o prefixo é VITE_).
# A publishable key (sb_publishable_…) substitui a anon key antiga e
# pode ir para o navegador: quem protege os dados é a RLS.
# ---------------------------------------------------------------------
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
