{
  "name": "chaveiro-formiga",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "// --- banco ---": "",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:logs": "docker compose logs -f db auth realtime-dev.supabase-realtime",
    "db:psql": "docker compose exec db psql -U postgres",
    "// --- migrations e seeds ---": "",
    "db:migrate": "bash scripts/migrate.sh",
    "db:seed:prod": "bash scripts/seed.sh prod",
    "db:seed:demo": "bash scripts/seed.sh demo",
    "db:reset:prod": "bash scripts/reset-to-prod.sh",
    "db:bootstrap": "bash scripts/bootstrap-users.sh",
    "// --- tipos ---": "",
    "db:types": "bash scripts/gen-types.sh",
    "// --- backup ---": "",
    "backup": "bash scripts/backup.sh",
    "restaurar": "bash scripts/restaurar.sh",
    "// --- testes ---": "",
    "test:api": "bash scripts/testes.sh",
    "// --- nuvem ---": "",
    "cloud:deploy": "bash scripts/cloud-deploy.sh",
    "cloud:migrations": "bash scripts/cloud-deploy.sh --so-migrations",
    "cloud:limpar-bucket": "bash scripts/limpar-bucket.sh",
    "// --- setup ---": "",
    "keys": "node scripts/gen-keys.mjs",
    "setup": "npm run keys && npm run db:up && npm run db:bootstrap"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.417.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  }
}
